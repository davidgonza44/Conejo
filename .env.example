# Copiar este archivo a .env y completar con las credenciales locales.

# Clave secreta de Flask (sesiones). Generar una propia para producción.
SECRET_KEY=change-me

# Conexión a MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change-me
DB_NAME=inventory_database

# Credenciales del usuario administrador inicial (datos semilla)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Entorno: development | production
# En development el token passwordless se muestra en la respuesta (solo pruebas).
APP_ENV=development

# Minutos de vigencia del token de login passwordless
PASSWORDLESS_TOKEN_MINUTES=15

# Login con Google (OpenID Connect).
# Crear credenciales OAuth 2.0 en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Correo saliente (SMTP) ---
# MAIL_ENABLED=false: no se envía correo real; en development los flujos
# devuelven dev_token / dev_reset_link para probar sin SMTP.
# Para Gmail: activar verificación en 2 pasos y crear una contraseña de
# aplicación en https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com
MAIL_FROM_NAME=Ferretería El Conejo

# URL base pública para armar los enlaces enviados por correo
APP_BASE_URL=http://localhost:5000

# Minutos de vigencia del enlace de recuperación de contraseña
PASSWORD_RESET_TOKEN_MINUTES=30
