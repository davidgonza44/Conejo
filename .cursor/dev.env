# Plantilla de variables de entorno para desarrollo en Cloud Agent.
# La copia el script .cursor/install.sh a .env si aún no existe.
SECRET_KEY=dev-secret-key-local

# Conexión a MySQL 8 local (instalado por el script de setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=inventory_database

# Credenciales del usuario administrador inicial (datos semilla)
ADMIN_EMAIL=admin@elconejo.com
ADMIN_PASSWORD=admin123

# Entorno: development | production
APP_ENV=development

# Minutos de vigencia del token passwordless
PASSWORDLESS_TOKEN_MINUTES=15

# Login con Google (OpenID Connect) — no configurado en desarrollo local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Correo saliente (SMTP) — deshabilitado en desarrollo ---
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_FROM_NAME=Ferretería El Conejo

# URL base pública para armar los enlaces enviados por correo
APP_BASE_URL=http://localhost:5000

# Minutos de vigencia del enlace de recuperación de contraseña
PASSWORD_RESET_TOKEN_MINUTES=30
